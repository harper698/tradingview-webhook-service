# Reference only: this app does not automatically load .env files.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this in the process environment; never commit a real value.
WEBHOOK_SECRET=
WEBHOOK_DB_PATH=data/alerts.sqlite3
WEBHOOK_MAX_AGE_SECONDS=300
WEBHOOK_FUTURE_SKEW_SECONDS=30
WEBHOOK_ALLOWED_SYMBOLS=BINANCE:BTCUSDT,NYSE:IBM
